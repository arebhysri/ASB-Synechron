<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML /// comments are shown in Swagger. 1591 = missing comment on public members (not required everywhere). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CardControl.Data\CardControl.Data.csproj" />
    <ProjectReference Include="..\CardControl.Interface\CardControl.Interface.csproj" />
    <ProjectReference Include="..\CardControl.Model\CardControl.Model.csproj" />
    <ProjectReference Include="..\CardControl.Repository\CardControl.Repository.csproj" />
    <ProjectReference Include="..\CardControl.Service\CardControl.Service.csproj" />
  </ItemGroup>

</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Must match the URL the provider is reachable on (see --urls in the README).
  "Issuer": "http://localhost:5090",
  "TenantId": "7d2e4c1a-5b3f-4e8a-9c6d-1f0a2b3c4d5e",
  "TokenLifetimeSeconds": 3600,

  // APIs that tokens can be requested for, using scope "<resource>/.default".
  "Resources": [ "api://card-control", "api://other-api" ],

  // Dev-only clients for this mock. These secrets are not sensitive.
  "Clients": [
    {
      "ClientId": "partner-app",
      "ClientSecret": "dev-only-partner-app-secret",
      "ObjectId": "3b8f2c6e-9a1d-4f7b-8e2c-5d6a7b8c9d01",
      "Roles": [ "CardControl.Write" ]
    },
    {
      "ClientId": "partner-readonly",
      "ClientSecret": "dev-only-partner-readonly-secret",
      "ObjectId": "9c1e7a4b-2d6f-4b8e-a3c5-7e8f9a0b1c02",
      "Roles": []
    }
  ]
}
